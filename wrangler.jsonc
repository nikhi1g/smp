{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smp-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://nikhi1g.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8787,http://127.0.0.1:8787",
    "OPENROUTER_MODEL": "~deepseek/deepseek-v4-flash-latest"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
